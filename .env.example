# Copia este fichero a .env.local y rellena con los valores de tu proyecto
# de Firebase (Consola de Firebase > Configuración del proyecto > tus apps).
# .env.local ya está en .gitignore por defecto en proyectos Vite.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Client ID de tipo "Web" del proyecto de Google Cloud/Firebase (APIs y
# servicios > Credenciales), usado para el login con Google en Android.
VITE_GOOGLE_WEB_CLIENT_ID=
